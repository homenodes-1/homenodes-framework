        <mxCell id="zone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;arcSize=12;spacing=8;" value="&lt;b style=&quot;font-size:15px&quot;&gt;3. Zoning and Land Use&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Home-based business rules, electrical code, noise and heat, grid load&lt;/span&gt;" vertex="1">
