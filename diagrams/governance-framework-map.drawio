        <mxCell id="sec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;arcSize=12;spacing=8;" value="&lt;b style=&quot;font-size:15px&quot;&gt;1. Security Standards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Minimum controls, isolation from household network, patching, incident response&lt;/span&gt;" vertex="1">
